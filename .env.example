# ---------------------------------------------------------------------------
# ESPN Fantasy Football league credentials
# ---------------------------------------------------------------------------
# Your league is private, so the ESPN API needs two cookie values from a
# browser session that is logged into ESPN and a member of the league.
# See the README ("Finding your ESPN cookies") for step-by-step instructions.

# The `espn_s2` cookie value (long alphanumeric string, keep quotes if it has
# special characters like `%2F`, `%3D`, etc. — copy it exactly as shown).
ESPN_S2=

# The `SWID` cookie value, including the curly braces, e.g. {ABCD1234-...}
ESPN_SWID=

# Your league ID — the numeric `leagueId` in the URL when you view your
# league on espn.com, e.g. https://fantasy.espn.com/football/league?leagueId=123456
LEAGUE_ID=

# ---------------------------------------------------------------------------
# Database (Turso) — required in production, not needed for local dev
# ---------------------------------------------------------------------------
# Locally, the app just uses a SQLite file (./data/league.db) automatically —
# leave these blank and you don't need a Turso account at all for local dev.
#
# In production (Vercel or any serverless host), a local file doesn't
# reliably persist between requests, so set these to a free Turso database
# instead (same SQLite engine, just hosted). See README "Setting up Turso".
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Earliest season to attempt to sync. If unset, the sync script will probe
# backwards from the current year until ESPN stops returning data for your
# league (i.e. it auto-detects how far back your league's history goes).
# LEAGUE_START_YEAR=2015

# Where the local SQLite cache lives when TURSO_DATABASE_URL isn't set.
# Defaults to ./data/league.db
# DATABASE_PATH=./data/league.db

# Shared secret used to authorize the weekly cron sync endpoint
# (/api/cron/sync) and the manual "refresh now" button in production.
# Generate any random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Override the league display name shown in the UI (defaults to
# "Oakwood Fantasy Football"). See README "Rebranding".
# NEXT_PUBLIC_LEAGUE_NAME=My League Name
